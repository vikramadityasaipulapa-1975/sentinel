# Documentation only: these files are not loaded automatically.
# Set values in each terminal with $env:NAME = 'value'. No secrets are needed in P1.
PAYMENT_URL=http://127.0.0.1:3002
PAYMENT_TIMEOUT_MS=2000
# Payment process only. Restart that process to change modes.
PAYMENT_FAULT_MODE=normal
PAYMENT_FAULT_DELAY_MS=500

# P2: use scripts/init-local.py to generate an ignored .env with random values.
# These are fake placeholders; do not copy real secrets into this example.
POSTGRES_PASSWORD=replace-with-local-only-password
DATABASE_URL=postgresql://sentinel:replace-with-local-only-password@127.0.0.1:55432/sentinel
STORAGE_MODE=postgres
PAYMENT_MAX_ATTEMPTS=2
# A named version overrides ad-hoc fault mode/delay with its fixed profile.
PAYMENT_VERSION=payment-v1

# P3.1 API: scripts/api-local.py generates a separate ignored .env.api.
# These variables belong to the main API, not the demo payment process.
SENTINEL_POSTGRES_PASSWORD=replace-with-local-api-password
SENTINEL_DATABASE_URL=postgresql://sentinel_api:replace-with-local-api-password@127.0.0.1:55434/sentinel_api
SENTINEL_DATABASE_TLS=disable
SENTINEL_API_PORT=3000
SENTINEL_DB_PORT=55434
# P3.3: fake placeholder only. Local helper generates a random 32-byte hex secret.
# Hosted instances must share one secret from their secret manager.
SENTINEL_JWT_SECRET=replace-with-64-random-hex-characters
# P3.4: separate local Redis volume; helper generates random credentials.
SENTINEL_REDIS_PASSWORD=replace-with-local-redis-password
SENTINEL_REDIS_PORT=56379
SENTINEL_REDIS_URL=redis://default:replace-with-local-redis-password@127.0.0.1:56379/0
# Hosted Redis must use rediss:// with verified certificates and private ingress.
# Hosted API database: SENTINEL_DATABASE_TLS=verify-full (the secure default).
# Use a provider database URL without query parameters. If required, configure
# SENTINEL_DATABASE_CA with the provider's PEM CA certificate in your secret store.

# P4.5: distinct webhook credential; generated only in ignored local configuration.
SENTINEL_ALERT_WEBHOOK_SECRET=replace-with-64-random-hex-characters
